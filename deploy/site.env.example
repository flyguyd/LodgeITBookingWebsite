# /opt/lodgeit-site/.env — the booking site's WIRING (owner oase, mode 600).
# Business configuration never lives here; it comes from Lodge Ops through
# the engine. This file is the ratebox layout (deploy/ratebox/README.md in
# the engine repo); on the shared webbox only ENGINE_URL/SITE_PUBLIC_URL differ.

PORT=3200
# Bind the DMZ-facing address only — the DMZ Caddy is the site's ONLY caller.
# Unset = every interface (the shared webbox / the e2e rig).
LISTEN_HOST=<ratebox DMZ-facing IP>

# The engine beside it, while both share ratebox. When the engine moves to its
# own box this becomes that box's tunnel/LAN address — nothing else changes.
ENGINE_URL=http://127.0.0.1:3100
CLIENT_KEY=site
CLIENT_SECRET=<generated on the Lodge Ops Booking Engine page, Service clients card>

# The address guests use — the DMZ Caddy's public site. Reported in the
# heartbeat: Lodge Ops links to it AND builds the engine's public webhook
# URLs from its origin (1.3.40), so it must be the real public name.
SITE_PUBLIC_URL=https://book.7starlodges.com/

# Guest rate limiting (per IP, X-Forwarded-For last hop = the DMZ Caddy's
# client_ip). Defaults shown.
#RATE_LIMIT=120
#RATE_WINDOW_MS=60000
